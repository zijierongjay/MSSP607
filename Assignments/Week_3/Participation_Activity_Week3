    {
      "cell_type": "code",
      "source": [
        "def collatz(n):\n",
        "    sequence = [n]\n",
        "\n",
        "    while n != 1:\n",
        "        if n % 2 == 0:\n",
        "            n = n // 2\n",
        "        else:\n",
        "            n = 3 * n + 1\n",
        "\n",
        "        sequence.append(n)\n",
        "\n",
        "    return sequence\n",
        "\n",
        "\n",
        "try:\n",
        "    number = int(input(\"Enter a starting number greater than 0: \"))\n",
        "\n",
        "    if number <= 0:\n",
        "        print(\"You must enter an integer greater than 0.\")\n",
        "\n",
        "    else:\n",
        "        result = collatz(number)\n",
        "\n",
        "        print(\"Collatz sequence:\")\n",
        "        print(result)\n",
        "\n",
        "        print(\"Number of values in the sequence:\", len(result))\n",
        "\n",
        "except ValueError:\n",
        "    print(\"Please enter a valid integer.\")"
      ],
